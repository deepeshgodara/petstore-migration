CREATE SCHEMA PUBLIC AUTHORIZATION DBA
SET SCHEMA PUBLIC
CREATE MEMORY TABLE PUBLIC.ACCOUNT(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,STATUS VARCHAR(255),CONTACTINFO_OPENEJB_PK BIGINT,CREDITCARD_OPENEJB_PK BIGINT)
CREATE INDEX I_ACCOUNT_CONTACTINFO ON PUBLIC.ACCOUNT(CONTACTINFO_OPENEJB_PK)
CREATE INDEX I_ACCOUNT_CREDITCARD ON PUBLIC.ACCOUNT(CREDITCARD_OPENEJB_PK)
CREATE MEMORY TABLE PUBLIC.ADDRESS(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,CITY VARCHAR(255),COUNTRY VARCHAR(255),STATE VARCHAR(255),STREETNAME1 VARCHAR(255),STREETNAME2 VARCHAR(255),ZIPCODE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.CONTACTINFO(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,EMAIL VARCHAR(255),FAMILYNAME VARCHAR(255),GIVENNAME VARCHAR(255),TELEPHONE VARCHAR(255),ADDRESS_OPENEJB_PK BIGINT)
CREATE INDEX I_CNTCTNF_ADDRESS ON PUBLIC.CONTACTINFO(ADDRESS_OPENEJB_PK)
CREATE MEMORY TABLE PUBLIC.COUNTER(NAME VARCHAR(255) NOT NULL PRIMARY KEY,COUNTER INTEGER)
CREATE MEMORY TABLE PUBLIC.CREDITCARD(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,CARDNUMBER VARCHAR(255),CARDTYPE VARCHAR(255),EXPIRYDATE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.CUSTOMER(USERID VARCHAR(255) NOT NULL PRIMARY KEY,PROFILE_OPENEJB_PK BIGINT,ACCOUNT_OPENEJB_PK BIGINT)
CREATE INDEX I_CUSTOMR_ACCOUNT ON PUBLIC.CUSTOMER(ACCOUNT_OPENEJB_PK)
CREATE INDEX I_CUSTOMR_PROFILE ON PUBLIC.CUSTOMER(PROFILE_OPENEJB_PK)
CREATE MEMORY TABLE PUBLIC.OPENJPA_SEQUENCE_TABLE(ID TINYINT NOT NULL PRIMARY KEY,SEQUENCE_VALUE BIGINT)
CREATE MEMORY TABLE PUBLIC.PROFILE(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,BANNERPREFERENCE BIT(1),FAVORITECATEGORY VARCHAR(255),MYLISTPREFERENCE BIT(1),PREFERREDLANGUAGE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.USER(USERNAME VARCHAR(255) NOT NULL PRIMARY KEY,PASSWORD VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.INVENTORY(ITEMID VARCHAR(255) NOT NULL PRIMARY KEY,QUANTITY INTEGER)
CREATE MEMORY TABLE PUBLIC.LINEITEM(OPENEJB_PK BIGINT NOT NULL PRIMARY KEY,CATEGORYID VARCHAR(255),ITEMID VARCHAR(255),LINENUMBER VARCHAR(255),PRODUCTID VARCHAR(255),QUANTITY INTEGER,QUANTITYSHIPPED INTEGER,UNITPRICE DOUBLE,SUPPLIERORDER_LINEITEMS_POID VARCHAR(255),PURCHASEORDER_LINEITEMS_POID VARCHAR(255))
CREATE INDEX I_LINITEM_SUPPLIERORDER_LINEITEMS ON PUBLIC.LINEITEM(SUPPLIERORDER_LINEITEMS_POID)
CREATE MEMORY TABLE PUBLIC.SUPPLIERORDER(POID VARCHAR(255) NOT NULL PRIMARY KEY,PODATE BIGINT,POSTATUS VARCHAR(255),CONTACTINFO_OPENEJB_PK BIGINT)
CREATE INDEX I_SPPLRDR_CONTACTINFO ON PUBLIC.SUPPLIERORDER(CONTACTINFO_OPENEJB_PK)
CREATE MEMORY TABLE PUBLIC.MANAGER(ORDERID VARCHAR(255) NOT NULL PRIMARY KEY,STATUS VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.PURCHASEORDER(POID VARCHAR(255) NOT NULL PRIMARY KEY,PODATE BIGINT,POEMAILID VARCHAR(255),POLOCALE VARCHAR(255),POUSERID VARCHAR(255),POVALUE DOUBLE,CONTACTINFO_OPENEJB_PK BIGINT,CREDITCARD_OPENEJB_PK BIGINT)
CREATE INDEX I_PRCHRDR_CONTACTINFO ON PUBLIC.PURCHASEORDER(CONTACTINFO_OPENEJB_PK)
CREATE INDEX I_PRCHRDR_CREDITCARD ON PUBLIC.PURCHASEORDER(CREDITCARD_OPENEJB_PK)
CREATE MEMORY TABLE PUBLIC.CATEGORY(CATID CHARACTER(10) NOT NULL,CONSTRAINT PK_CATEGORY PRIMARY KEY(CATID))
CREATE MEMORY TABLE PUBLIC.CATEGORY_DETAILS(CATID CHARACTER(10) NOT NULL,NAME VARCHAR(80) NOT NULL,IMAGE VARCHAR(255),DESCN VARCHAR(255),LOCALE CHARACTER(10) NOT NULL,CONSTRAINT PK_CATEGORY_DETAILS PRIMARY KEY(CATID,LOCALE),CONSTRAINT FK_CATEGORY_DETAILS_1 FOREIGN KEY(CATID) REFERENCES PUBLIC.CATEGORY(CATID))
CREATE MEMORY TABLE PUBLIC.PRODUCT(PRODUCTID CHARACTER(10) NOT NULL,CATID CHARACTER(10) NOT NULL,CONSTRAINT PK_PRODUCT PRIMARY KEY(PRODUCTID),CONSTRAINT FK_PRODUCT_1 FOREIGN KEY(CATID) REFERENCES PUBLIC.CATEGORY(CATID))
CREATE MEMORY TABLE PUBLIC.PRODUCT_DETAILS(PRODUCTID CHARACTER(10) NOT NULL,LOCALE CHARACTER(10) NOT NULL,NAME VARCHAR(80) NOT NULL,IMAGE VARCHAR(255),DESCN VARCHAR(255),CONSTRAINT PK_PRODUCT_DETAILS PRIMARY KEY(PRODUCTID,LOCALE),CONSTRAINT FK_PRODUCT_DETAILS_1 FOREIGN KEY(PRODUCTID) REFERENCES PUBLIC.PRODUCT(PRODUCTID))
CREATE MEMORY TABLE PUBLIC.ITEM(ITEMID CHARACTER(10) NOT NULL,PRODUCTID CHARACTER(10) NOT NULL,CONSTRAINT PK_ITEM PRIMARY KEY(ITEMID),CONSTRAINT FK_ITEM_1 FOREIGN KEY(PRODUCTID) REFERENCES PUBLIC.PRODUCT(PRODUCTID))
CREATE MEMORY TABLE PUBLIC.ITEM_DETAILS(ITEMID CHARACTER(10) NOT NULL,LISTPRICE DECIMAL(10,2) NOT NULL,UNITCOST DECIMAL(10,2) NOT NULL,LOCALE CHARACTER(10) NOT NULL,IMAGE CHARACTER(255) NOT NULL,DESCN VARCHAR(255) NOT NULL,ATTR1 VARCHAR(80),ATTR2 VARCHAR(80),ATTR3 VARCHAR(80),ATTR4 VARCHAR(80),ATTR5 VARCHAR(80),CONSTRAINT PK_ITEM_DETAILS PRIMARY KEY(ITEMID,LOCALE),CONSTRAINT FK_ITEM_DETAILS_1 FOREIGN KEY(ITEMID) REFERENCES PUBLIC.ITEM(ITEMID))
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
